# PLAID server configuration.
# Edit, then apply with: sudo systemctl restart plaid
# Your changes are kept when PLAID is upgraded.

PLAID_PORT=32500
PLAID_HOST=0.0.0.0
PLAID_DATA_DIR=/var/lib/plaid
PLAID_LOG_LEVEL=info
PLAID_LOG_FORMAT=text

# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers PLAID
# believes, as a comma-separated list of IPs or CIDRs. Empty: none.
#PLAID_TRUSTED_PROXIES=127.0.0.1,::1

# Name clients show for this server. Empty: the machine's hostname.
#PLAID_SERVER_NAME=Living room
